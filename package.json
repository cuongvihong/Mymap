{
  "name": "mapapp",
  "version": "0.1.0",
  "description": "MapApp, bản đồ chức năng dự án",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Hồng Vĩ Cường",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win dir && node scripts/stage-kho.mjs win",
    "dist:linux": "npm run build && electron-builder --linux AppImage && node scripts/stage-kho.mjs linux"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.12.0",
    "electron": "44.4.5",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "elkjs": "0.12.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
